# 复制本文件为 .env，再填入你自己的配置（.env 已被 .gitignore 忽略，不会提交到 git）

# 服务端口
PORT=3000

# PostgreSQL 连接（默认端口 5432，默认用户 postgres）
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=            # ← 填你的 PostgreSQL 密码
DB_NAME=peteacher

# JWT 密钥（生产环境一定要换成一段足够长的随机字符串）
JWT_SECRET=please-change-this-secret-123456
JWT_EXPIRES_IN=7d
